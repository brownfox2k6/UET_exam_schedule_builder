"""
Some metaheuristic approaches for the Capacitated Examination Timetabling Problem (CETP).
"""

from collections.abc import Callable, Sequence
import enum


class ExamSection:
    def __init__(self, code: str, students: Sequence[str], feasible_rooms: Sequence[str]) -> None: ...

    @property
    def code(self) -> str: ...

    @property
    def students(self) -> list[str]: ...

    @property
    def feasible_rooms(self) -> list[str]: ...

class Exam:
    def __init__(self, code: str, credits: int, sections: Sequence[ExamSection], feasible_timestamps: Sequence[int]) -> None: ...

    @property
    def code(self) -> str: ...

    @property
    def credits(self) -> int: ...

    @property
    def sections(self) -> list[ExamSection]: ...

    @property
    def feasible_timestamps(self) -> list[int]: ...

class Room:
    def __init__(self, code: str, capacity: int, location: str = 'default', type: str = 'default') -> None: ...

    @property
    def code(self) -> str: ...

    @code.setter
    def code(self, arg: str, /) -> None: ...

    @property
    def capacity(self) -> int: ...

    @capacity.setter
    def capacity(self, arg: int, /) -> None: ...

    @property
    def location(self) -> str: ...

    @location.setter
    def location(self, arg: str, /) -> None: ...

    @property
    def type(self) -> str: ...

    @type.setter
    def type(self, arg: str, /) -> None: ...

class ProblemData:
    def __init__(self, exams: Sequence[Exam], rooms: Sequence[Room]) -> None: ...

    @property
    def num_exams(self) -> int: ...

    @property
    def num_slots(self) -> int: ...

    @property
    def num_rooms(self) -> int: ...

    @property
    def num_sections(self) -> int: ...

    @property
    def num_students(self) -> int: ...

    @property
    def num_enrollments(self) -> int: ...

    @property
    def exam_codes(self) -> list[str]: ...

    @property
    def section_codes(self) -> list[str]: ...

    @property
    def room_codes(self) -> list[str]: ...

    @property
    def slot_timestamps(self) -> list[int]: ...

class EvalParams:
    def __init__(self) -> None: ...

    @property
    def penalty_decay_base(self) -> float: ...

    @penalty_decay_base.setter
    def penalty_decay_base(self, arg: float, /) -> None: ...

class AcoParams:
    def __init__(self) -> None: ...

    @property
    def num_iters(self) -> int: ...

    @num_iters.setter
    def num_iters(self, arg: int, /) -> None: ...

    @property
    def num_ants(self) -> int: ...

    @num_ants.setter
    def num_ants(self, arg: int, /) -> None: ...

    @property
    def alpha(self) -> float: ...

    @alpha.setter
    def alpha(self, arg: float, /) -> None: ...

    @property
    def beta(self) -> float: ...

    @beta.setter
    def beta(self, arg: float, /) -> None: ...

    @property
    def rho(self) -> float: ...

    @rho.setter
    def rho(self, arg: float, /) -> None: ...

    @property
    def tau_min(self) -> float: ...

    @tau_min.setter
    def tau_min(self, arg: float, /) -> None: ...

    @property
    def tau_max(self) -> float: ...

    @tau_max.setter
    def tau_max(self, arg: float, /) -> None: ...

    @property
    def max_retries(self) -> int: ...

    @max_retries.setter
    def max_retries(self, arg: int, /) -> None: ...

    def set_tau_bounds(self, tau_min: float, tau_max: float) -> None: ...

class LsParams:
    def __init__(self) -> None: ...

    @property
    def prob_1_move(self) -> float: ...

    @prob_1_move.setter
    def prob_1_move(self, arg: float, /) -> None: ...

    @property
    def max_improvements(self) -> int: ...

    @max_improvements.setter
    def max_improvements(self, arg: int, /) -> None: ...

    @property
    def patience(self) -> int: ...

    @patience.setter
    def patience(self, arg: int, /) -> None: ...

class RoomAssignmentParams:
    def __init__(self) -> None: ...

    @property
    def max_time_seconds(self) -> float: ...

    @max_time_seconds.setter
    def max_time_seconds(self, arg: float, /) -> None: ...

    @property
    def num_workers(self) -> int: ...

    @num_workers.setter
    def num_workers(self, arg: int, /) -> None: ...

    @property
    def random_seed(self) -> int: ...

    @random_seed.setter
    def random_seed(self, arg: int, /) -> None: ...

class Hyperparams:
    def __init__(self, eval: EvalParams = ..., aco: AcoParams = ..., ls: LsParams = ..., room_assignment: RoomAssignmentParams = ...) -> None: ...

    @property
    def eval(self) -> EvalParams: ...

    @eval.setter
    def eval(self, arg: EvalParams, /) -> None: ...

    @property
    def aco(self) -> AcoParams: ...

    @aco.setter
    def aco(self, arg: AcoParams, /) -> None: ...

    @property
    def ls(self) -> LsParams: ...

    @ls.setter
    def ls(self, arg: LsParams, /) -> None: ...

    @property
    def room_assignment(self) -> RoomAssignmentParams: ...

    @room_assignment.setter
    def room_assignment(self, arg: RoomAssignmentParams, /) -> None: ...

class SlotResult:
    @property
    def found(self) -> bool: ...

    @property
    def schedule(self) -> list[int]: ...

    @property
    def penalty(self) -> float: ...

class RoomAssignmentStatus(enum.Enum):
    OPTIMAL = 0

    FEASIBLE = 1

    INFEASIBLE = 2

    UNKNOWN = 3

    MODEL_INVALID = 4

class RoomAssignment:
    @property
    def status(self) -> RoomAssignmentStatus: ...

    @property
    def slot_statuses(self) -> list[RoomAssignmentStatus]: ...

    @property
    def found(self) -> bool: ...

    @property
    def room_count(self) -> int: ...

    @property
    def extra_locations(self) -> int: ...

    @property
    def unused_capacity(self) -> int: ...

    def rooms_for_section(self, section_id: int) -> list[int]: ...

class TimetableResult:
    @property
    def slots(self) -> SlotResult: ...

    @property
    def rooms(self) -> RoomAssignment | None: ...

def solve_slots_aco(problem: ProblemData, aco_params: AcoParams, eval_params: EvalParams, *, base_seed: int = 42, callback: Callable[[int, float], None] | None = None) -> SlotResult: ...

def improve_slots(problem: ProblemData, schedule: Sequence[int], ls_params: LsParams, eval_params: EvalParams, *, base_seed: int = 42) -> SlotResult: ...

def assign_rooms(problem: ProblemData, schedule: Sequence[int], room_params: RoomAssignmentParams) -> RoomAssignment: ...

def solve_timetable(problem: ProblemData, hyperparams: Hyperparams, *, base_seed: int = 42, callback: Callable[[int, float], None] | None = None) -> TimetableResult: ...
