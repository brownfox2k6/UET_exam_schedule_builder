"""
Solver for University Examination Timetabling using Ant Colony Optimization and Local Search
"""

from collections.abc import Callable, Sequence


class ExamSection:
    def __init__(self, code: str, students: Sequence[str]) -> None: ...

    @property
    def code(self) -> str: ...

    @code.setter
    def code(self, arg: str, /) -> None: ...

    @property
    def students(self) -> list[str]: ...

    @students.setter
    def students(self, arg: Sequence[str], /) -> None: ...

    @property
    def student_count(self) -> int: ...

class Exam:
    def __init__(self, code: str, credits: int, sections: Sequence[ExamSection], feasible_slots: Sequence[int], feasible_rooms: Sequence[int]) -> None: ...

    @property
    def code(self) -> str: ...

    @code.setter
    def code(self, arg: str, /) -> None: ...

    @property
    def credits(self) -> int: ...

    @credits.setter
    def credits(self, arg: int, /) -> None: ...

    @property
    def sections(self) -> list[ExamSection]: ...

    @sections.setter
    def sections(self, arg: Sequence[ExamSection], /) -> None: ...

    @property
    def feasible_slots(self) -> list[int]: ...

    @feasible_slots.setter
    def feasible_slots(self, arg: Sequence[int], /) -> None: ...

    @property
    def feasible_rooms(self) -> list[int]: ...

    @feasible_rooms.setter
    def feasible_rooms(self, arg: Sequence[int], /) -> None: ...

    @property
    def section_count(self) -> int: ...

    @property
    def student_count(self) -> int: ...

class Room:
    def __init__(self, code: str, capacity: int, location: str = 'default', type: str = 'default') -> None: ...

    @property
    def code(self) -> str: ...

    @code.setter
    def code(self, arg: str, /) -> None: ...

    @property
    def capacity(self) -> int: ...

    @capacity.setter
    def capacity(self, arg: int, /) -> None: ...

    @property
    def location(self) -> str: ...

    @location.setter
    def location(self, arg: str, /) -> None: ...

    @property
    def type(self) -> str: ...

    @type.setter
    def type(self, arg: str, /) -> None: ...

class EvalParams:
    def __init__(self) -> None: ...

    @property
    def penalty_decay_base(self) -> float: ...

    @penalty_decay_base.setter
    def penalty_decay_base(self, arg: float, /) -> None: ...

class AcoParams:
    def __init__(self) -> None: ...

    @property
    def num_iters(self) -> int: ...

    @num_iters.setter
    def num_iters(self, arg: int, /) -> None: ...

    @property
    def num_ants(self) -> int: ...

    @num_ants.setter
    def num_ants(self, arg: int, /) -> None: ...

    @property
    def alpha(self) -> float: ...

    @alpha.setter
    def alpha(self, arg: float, /) -> None: ...

    @property
    def beta(self) -> float: ...

    @beta.setter
    def beta(self, arg: float, /) -> None: ...

    @property
    def rho(self) -> float: ...

    @rho.setter
    def rho(self, arg: float, /) -> None: ...

    @property
    def tau_min(self) -> float: ...

    @tau_min.setter
    def tau_min(self, arg: float, /) -> None: ...

    @property
    def tau_max(self) -> float: ...

    @tau_max.setter
    def tau_max(self, arg: float, /) -> None: ...

    @property
    def max_retries(self) -> int: ...

    @max_retries.setter
    def max_retries(self, arg: int, /) -> None: ...

    def set_tau_bounds(self, tau_min: float, tau_max: float) -> None: ...

class LsParams:
    def __init__(self) -> None: ...

    @property
    def prob_1_move(self) -> float: ...

    @prob_1_move.setter
    def prob_1_move(self, arg: float, /) -> None: ...

    @property
    def max_improvements(self) -> int: ...

    @max_improvements.setter
    def max_improvements(self, arg: int, /) -> None: ...

    @property
    def patience(self) -> int: ...

    @patience.setter
    def patience(self, arg: int, /) -> None: ...

class Hyperparams:
    def __init__(self, _eval: EvalParams = ..., _aco: AcoParams = ..., _ls: LsParams = ...) -> None: ...

    @property
    def eval(self) -> EvalParams: ...

    @eval.setter
    def eval(self, arg: EvalParams, /) -> None: ...

    @property
    def aco(self) -> AcoParams: ...

    @aco.setter
    def aco(self, arg: AcoParams, /) -> None: ...

    @property
    def ls(self) -> LsParams: ...

    @ls.setter
    def ls(self, arg: LsParams, /) -> None: ...

class Solution:
    @property
    def schedule(self) -> list[int]: ...

    @property
    def fitness(self) -> float: ...

class AntColony:
    def __init__(self, hyperparams: Hyperparams, exams: Sequence[Exam], slot_timestamps: Sequence[int], rooms: Sequence[Room], base_seed: int = 42) -> None: ...

    def run_one_iteration(self) -> float: ...

    def run(self, callback: Callable[[int, float], None] | None = None) -> None: ...

    @property
    def global_best_schedule(self) -> list[int]: ...

    @property
    def global_best_fitness(self) -> float: ...
