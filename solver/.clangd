CompileFlags:
  Add: [
    -Wall,
    -Wextra,
    -Wpedantic,
    -Wconversion,
    -Wsign-conversion,
    -Wshadow,
    -Wshorten-64-to-32,
  ]

Diagnostics:
  ClangTidy:
    Add: [
      bugprone-*, 
      performance-*, 
      readability-*, 
      modernize-*, 
      concurrency-*, 
      portability-*,
      tautological-*
    ]